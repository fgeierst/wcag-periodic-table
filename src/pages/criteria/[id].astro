---
import type { GetStaticPaths } from "astro";
import type { SuccessCriteria } from "../../wcag";
import { getCriteria } from "../../data/criteria";
import Details from "../../components/Details.svelte";
import Layout from "../../layouts/Layout.astro";

export const getStaticPaths = (() =>
  getCriteria().map((criterion) => ({
    params: { id: criterion.ref_id },
    props: { criterion },
  }))) satisfies GetStaticPaths;

interface Props {
  criterion: SuccessCriteria;
}

const { criterion } = Astro.props;
---

<Layout title={`${criterion.ref_id} ${criterion.title} | WCAG periodic table`}>
  <div class="mx-auto max-w-3xl space-y-6">
    <nav aria-label="Criteria navigation">
      <a
        href="/"
        class="inline-block py-2 underline focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        Back to criteria
      </a>
    </nav>
    <main>
      <Details {criterion} />
    </main>
  </div>
</Layout>
