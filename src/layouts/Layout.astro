---
import "../global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const webmcpOriginTrialToken = import.meta.env.PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="WCAG sucess criteria displayed as a periodic table"
    />
    <meta name="viewport" content="width=device-width" />
    {webmcpOriginTrialToken && (
      <meta http-equiv="origin-trial" content={webmcpOriginTrialToken} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="m-3 mb-32 space-y-3">
    <slot />
  </body>
</html>
